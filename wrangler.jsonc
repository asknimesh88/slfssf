{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slfssf",
  "compatibility_date": "2026-09-21",
  // Build before every deploy, so it works even if the dashboard build command is empty.
  "build": { "command": "npm run build" },
  // Serve the site on the main domain. Cloudflare creates the DNS record on deploy.
  "routes": [{ "pattern": "slfssf.com", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  }
}
